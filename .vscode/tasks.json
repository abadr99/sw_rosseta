{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "gTest filter (Suite.Name, wildcards ok). * = all tests.",
            "default": "*"
        }
    ],
    "tasks": [
        {
            "label": "Lint",
            "type": "shell",
            "command": "bash ./scripts/github/linux/lint.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "cpplint",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            "label": "Configure (Debug)",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake --build build --parallel",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure (Debug)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "./build/tests/unit_tests --gtest_color=yes --gtest_filter=${input:gtestFilter}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build (Debug)",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
